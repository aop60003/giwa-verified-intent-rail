[Unit]
Description=GIWA static staging surface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=giwa
Group=giwa
WorkingDirectory=/opt/giwa/current
Environment=HOST=127.0.0.1
Environment=PORT=4176
Environment=GIWA_SKIP_PUBLIC_EXPORT=1
ExecStart=/opt/giwa/runtime/node-v22.16.0/bin/node --experimental-strip-types apps/web/scripts/serve-static.mjs
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
